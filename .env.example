# Database
POSTGRES_DB=hackathon
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+psycopg://hackathon:change-me-strong-password@db:5432/hackathon

# Backend
HTTP_PORT=80
ENVIRONMENT=production
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
REGISTRATION_DEADLINE=2026-10-10T15:00:00+06:00

# Admin. Generate the hash as described in README.md.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$replace_with_real_hash
